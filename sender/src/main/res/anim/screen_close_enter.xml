<?xml version="1.0" encoding="utf-8"?>
<!-- On back: the previous screen returns from slightly left and fades up (shared-axis X, backward). -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@interpolator/emphasized">
    <translate android:fromXDelta="-10%p" android:toXDelta="0" android:duration="300" />
    <alpha android:fromAlpha="0" android:toAlpha="1" android:duration="220" />
</set>
