<?xml version="1.0" encoding="utf-8"?>
<!-- On back: the previous screen returns from slightly left and fades up. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@interpolator/ds_ease_out">
    <translate android:fromXDelta="-4%p" android:toXDelta="0" android:duration="240" />
    <alpha android:fromAlpha="0" android:toAlpha="1" android:duration="180" />
</set>
