<?xml version="1.0" encoding="utf-8"?>
<!-- On back: the top screen slides out to the right and fades. Leaving is quicker than arriving -
     the user has already decided, so nothing should hold them up. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@interpolator/ds_ease_out">
    <translate android:fromXDelta="0" android:toXDelta="12%p" android:duration="200" />
    <alpha android:fromAlpha="1" android:toAlpha="0" android:duration="150" />
</set>
