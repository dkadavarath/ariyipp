<?xml version="1.0" encoding="utf-8"?>
<!-- Tactile press: a pressed control sinks to 97% and springs back on release. The press is quick
     (100ms) so it answers the finger straight away; the release is a little slower (200ms) so the
     return reads as a settle rather than a snap. Both are interruptible, which is why this is an
     animator and not a keyframed animation. Honours the system animator scale (off = instant). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="true" android:state_pressed="true">
        <set>
            <objectAnimator
                android:duration="100"
                android:interpolator="@interpolator/ds_ease_out"
                android:propertyName="scaleX"
                android:valueTo="0.97"
                android:valueType="floatType" />
            <objectAnimator
                android:duration="100"
                android:interpolator="@interpolator/ds_ease_out"
                android:propertyName="scaleY"
                android:valueTo="0.97"
                android:valueType="floatType" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator
                android:duration="200"
                android:interpolator="@interpolator/ds_ease_out"
                android:propertyName="scaleX"
                android:valueTo="1"
                android:valueType="floatType" />
            <objectAnimator
                android:duration="200"
                android:interpolator="@interpolator/ds_ease_out"
                android:propertyName="scaleY"
                android:valueTo="1"
                android:valueType="floatType" />
        </set>
    </item>
</selector>
