<?xml version="1.0" encoding="utf-8"?>
<!--
    One line of status: what it is, a plain-language detail, and a coloured badge for its state.
    Bound by com.noti.sender.ui.StatusRow; include it with an id and bind that.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingVertical="8dp">

    <ImageView
        android:id="@+id/status_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/ds_tile_bg"
        android:contentDescription="@null"
        android:padding="9dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/status_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/status_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/status_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/ds_pill_bg"
        android:maxLines="1"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:textAppearance="?attr/textAppearanceLabelMedium" />
</LinearLayout>
