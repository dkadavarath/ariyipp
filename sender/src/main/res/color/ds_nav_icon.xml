<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom-bar icon: sits on the primary-container pill when selected, plain secondary text colour
     otherwise (both pass 4.5:1 on their backgrounds). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="?attr/colorOnPrimaryContainer" android:state_checked="true" />
    <item android:color="?attr/colorOnSurfaceVariant" />
</selector>
