<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- To surface upload-failure alerts (runtime-requested on Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Reminders. SET_ALARM is a normal permission (granted at install, no prompt) and lets a
         parking expiry be handed to the phone's Clock app. SCHEDULE_EXACT_ALARM is only needed for
         the in-app parking alarm, which is opt-in in Reminder settings; bill reminders are ordinary
         high-priority notifications on an inexact wake and need neither. -->
    <!-- Lets ariyipp appear in Settings > Do Not Disturb access. Without it that screen simply
         does not list the app, and a channel's "Override Do Not Disturb" cannot be set by us. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- A full-screen intent so a parking alarm reaches the lock screen. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- See launchable apps in the app picker without QUERY_ALL_PACKAGES. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".NotiApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Noti">

        <!-- Report each FCM delivery to the BigQuery export (when the project has it linked), so a
             message the server accepted can be checked for whether it actually reached the device.
             Inert until the export is enabled in Firebase; carries no message content. -->
        <meta-data
            android:name="delivery_metrics_exported_to_big_query_enabled"
            android:value="true" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Noti.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.RoleOnboardingActivity" android:exported="false" />

        <activity
            android:name=".ui.AppPickerActivity"
            android:exported="false"
            android:label="@string/picker_title" />

        <activity
            android:name=".ui.HelpActivity"
            android:exported="false"
            android:label="@string/help_title" />

        <activity android:name=".ui.ConnectionActivity" android:exported="false" />
        <activity android:name=".ui.SyncActivity" android:exported="false" />
        <activity android:name=".ui.CompanionStatusActivity" android:exported="false" />
        <activity android:name=".ui.AppRulesActivity" android:exported="false" />
        <activity android:name=".ui.RelayReceiveActivity" android:exported="false" />
        <activity
            android:name=".ui.ChatActivity"
            android:exported="false"
            android:parentActivityName=".ui.MainActivity" />
        <activity android:name=".ui.ComposeActivity" android:exported="false" />
        <activity android:name=".ui.PrivacyActivity" android:exported="false" />
        <activity android:name=".ui.AppearanceActivity" android:exported="false" />
        <activity android:name=".ui.BackupActivity" android:exported="false" />
        <activity android:name=".ui.DiagnosticsActivity" android:exported="false" />
        <activity android:name=".ui.ReminderSettingsActivity" android:exported="false" />
        <activity android:name=".ui.ReminderRulesActivity" android:exported="false" />
        <activity android:name=".ui.ReminderRuleActivity" android:exported="false" />
        <activity android:name=".ui.ReminderEditActivity" android:exported="false" />

        <!-- The in-app parking alarm. Its own task and excluded from recents: it is a ringing
             screen, not somewhere to navigate back to. -->
        <activity
            android:name=".reminder.ParkingAlarmActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:showOnLockScreen="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Noti"
            android:turnScreenOn="true" />

        <service
            android:name=".capture.NotiListenerService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name=".push.NotiMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <receiver
            android:name=".boot.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <!-- Reminders are "09:00 local": a new time zone or a set clock moves that. -->
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".push.NotificationActionReceiver"
            android:exported="false" />

        <!-- Where a scheduled bill or parking reminder lands. -->
        <receiver
            android:name=".reminder.ReminderAlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".push.HeartbeatRetryReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.noti.logger.action.HEARTBEAT_RETRY" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
