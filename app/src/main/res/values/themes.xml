<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Noti" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Fallback brand palette; overridden by Material You dynamic color on Android 12+. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorSecondary">@color/teal_200</item>
    </style>

    <!-- Launch splash: the "n." icon on the blue brand background (AndroidX SplashScreen). -->
    <style name="Theme.Noti.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/noti_blue</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Noti</item>
    </style>
</resources>
