<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Noti" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand blue scheme (matches the icon); day/night values from colors.xml. Surfaces come
             from the Material3 DayNight parent. Follows the system light/dark setting. -->
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/brand_on_primary</item>
        <item name="colorPrimaryContainer">@color/brand_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/brand_on_primary_container</item>
        <item name="colorSecondary">@color/brand_secondary</item>
        <item name="colorOnSecondary">@color/brand_on_secondary</item>
        <item name="colorSecondaryContainer">@color/brand_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/brand_on_secondary_container</item>
    </style>

    <!-- AMOLED overlay: applied at runtime over the dark theme to push chrome/background surfaces to
         true black. colorSurfaceVariant is left alone so chat bubbles/inputs stay visible. -->
    <style name="ThemeOverlay.Noti.Amoled" parent="">
        <item name="android:colorBackground">#FF000000</item>
        <item name="colorSurface">#FF000000</item>
        <item name="colorSurfaceContainerLowest">#FF000000</item>
        <item name="colorSurfaceContainerLow">#FF000000</item>
        <item name="colorSurfaceContainer">#FF000000</item>
        <item name="colorSurfaceContainerHigh">#FF0C0E11</item>
        <item name="colorSurfaceContainerHighest">#FF14171C</item>
        <item name="colorSurfaceBright">#FF14171C</item>
        <item name="colorSurfaceDim">#FF000000</item>
    </style>

    <!-- Launch splash: the "n." icon on the blue brand background (AndroidX SplashScreen). -->
    <style name="Theme.Noti.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Noti</item>
    </style>
</resources>
