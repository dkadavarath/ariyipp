<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Noti" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand blue scheme (matches the icon); day/night values from colors.xml. Surfaces come
             from the Material3 DayNight parent. Follows the system light/dark setting. -->
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/brand_on_primary</item>
        <item name="colorPrimaryContainer">@color/brand_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/brand_on_primary_container</item>
        <item name="colorSecondary">@color/brand_secondary</item>
        <item name="colorOnSecondary">@color/brand_on_secondary</item>
        <item name="colorSecondaryContainer">@color/brand_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/brand_on_secondary_container</item>
        <!-- Neutralise the M3 lavender/blue-tinted surface ramp so cards and pages read neutral and
             consistent (Settings especially, being one large filled card). -->
        <item name="colorSurfaceVariant">@color/app_surface_variant</item>
        <item name="colorSurfaceContainerLowest">@color/app_surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/app_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/app_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/app_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/app_surface_container_highest</item>
        <!-- Slide + fade for opening/closing screens (settings sub-screens, chat, compose). -->
        <item name="android:windowAnimationStyle">@style/Noti.WindowAnimation</item>
    </style>

    <!-- Shared-axis-X activity transitions with emphasized easing. Only the activity open/close pairs
         are set, so the launcher/splash launch keeps the system default. -->
    <style name="Noti.WindowAnimation" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/screen_open_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/screen_open_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/screen_close_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/screen_close_exit</item>
    </style>

    <!-- AMOLED overlay: applied at runtime over the dark theme to push ALL chrome/background/card
         surfaces to true black (cards, nav bar, app bar, Status/Settings blocks). colorSurfaceVariant
         is deliberately left alone so chat bubbles, the compose field, and date pills stay visible.
         Cards read as seamless black; section titles and spacing carry the structure. -->
    <style name="ThemeOverlay.Noti.Amoled" parent="">
        <item name="android:colorBackground">#FF000000</item>
        <item name="colorSurface">#FF000000</item>
        <item name="colorSurfaceContainerLowest">#FF000000</item>
        <item name="colorSurfaceContainerLow">#FF000000</item>
        <item name="colorSurfaceContainer">#FF000000</item>
        <item name="colorSurfaceContainerHigh">#FF000000</item>
        <item name="colorSurfaceContainerHighest">#FF000000</item>
        <item name="colorSurfaceBright">#FF000000</item>
        <item name="colorSurfaceDim">#FF000000</item>
        <item name="elevationOverlayEnabled">false</item>
    </style>

    <!-- Small uppercase coloured section header for the flat Status/Settings screens. -->
    <style name="SectionLabel" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.06</item>
    </style>

    <!-- Small uppercase section label used to group the compose form. -->
    <style name="Compose.Eyebrow" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelMedium</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

    <!-- Launch splash: the "n." icon on the blue brand background (AndroidX SplashScreen). -->
    <style name="Theme.Noti.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Noti</item>
    </style>

    <!-- Section header on the pairing screen (kept identical to ariy's for a unified look). -->
    <style name="PairSectionHeader" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleSmall</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>
</resources>
