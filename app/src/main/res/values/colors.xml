<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The palette (brand, text, surfaces, AMOLED tiers) lives in :sender's colors.xml, shared by
         both roles. Only app-specific colours are here. -->

    <!-- Splash background: matches the theme-adaptive launcher icon (light here, dark in -night). -->
    <color name="splash_bg">#FFFFFFFF</color>

    <!-- Delivered read-receipt tick: needs to read as a distinct accent against the outgoing bubble
         fill (brand_primary), which is dark blue in light mode - a bright cyan pops against it. Dark
         mode's inverted (light) bubble fill needs the opposite: see values-night/. Light enough
         to clear 3:1 against the bubble (#40C4FF only managed 2.9:1). -->
    <color name="chat_tick_delivered">#80DEFF</color>
</resources>
