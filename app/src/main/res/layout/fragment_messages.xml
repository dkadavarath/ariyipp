<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Fixed height, not wrap_content: this row's weighted spacer (below) makes a wrap_content
         LinearLayout measure itself against the parent's AT_MOST spec instead of its children's
         natural size, so it silently expands to swallow all the space meant for the recycler below
         it - happens on first layout and every time this row goes back to VISIBLE (e.g. closing
         search), and looks exactly like the conversation list "disappearing".
         Also must match row_search's height exactly (see below) - any mismatch shifts the recycler
         by the difference every time the two rows swap, which reads as a jarring little jump. -->
    <LinearLayout
        android:id="@+id/row_collapsed"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btn_search"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_search"
            app:tint="?attr/colorOnSurfaceVariant"
            android:contentDescription="@string/messages_search_cd" />

        <View
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btn_overflow"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_more_vert"
            app:tint="?attr/colorOnSurfaceVariant"
            android:contentDescription="@string/messages_overflow_cd" />
    </LinearLayout>

    <!-- Fixed height, matching row_collapsed exactly - see the comment on that row. -->
    <FrameLayout
        android:id="@+id/row_search"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/search_pill_bg"
        android:visibility="gone">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="14dp"
            android:src="@drawable/ic_search"
            app:tint="?attr/colorOnSurfaceVariant"
            android:contentDescription="@null" />

        <EditText
            android:id="@+id/et_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:background="@null"
            android:paddingStart="46dp"
            android:paddingEnd="42dp"
            android:hint="@string/messages_search_hint"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="?attr/colorOnSurfaceVariant"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:inputType="text"
            android:maxLines="1"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no" />

        <ImageView
            android:id="@+id/img_search_clear"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="14dp"
            android:src="@drawable/ic_close"
            app:tint="?attr/colorOnSurfaceVariant"
            android:visibility="gone"
            android:contentDescription="@string/chat_close" />
    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="12dp" />

        <TextView
            android:id="@+id/txt_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="32dp"
            android:text="@string/messages_empty"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:alpha="0.7"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
