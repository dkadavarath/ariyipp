<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/screen_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize" />
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Intro -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0.85"
                android:lineSpacingExtra="3dp"
                android:text="@string/relay_intro"
                android:textAppearance="?attr/textAppearanceBodyMedium" />

            <!-- 1. Shared key -->
            <TextView
                style="@style/PairSectionHeader"
                android:text="@string/pair_hdr_key" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/label_relay_key">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_relay_key"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textNoSuggestions"
                    android:maxLines="2" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_generate_key"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_generate_key" />

            <!-- 2. This device's code -->
            <TextView
                style="@style/PairSectionHeader"
                android:text="@string/pair_hdr_this" />

            <TextView
                android:id="@+id/txt_token"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0.7"
                android:text="@string/loading"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textIsSelectable="true" />

            <ImageView
                android:id="@+id/img_qr"
                android:layout_width="240dp"
                android:layout_height="240dp"
                android:layout_gravity="center"
                android:layout_marginTop="12dp"
                android:contentDescription="@string/relay_qr_hint" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/relay_qr_hint"
                android:textAppearance="?attr/textAppearanceBodyMedium" />

            <!-- 3. The other device -->
            <TextView
                style="@style/PairSectionHeader"
                android:text="@string/pair_hdr_other" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_scan_ariy"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_scan_ariy" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/hint_sndi_token">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_sndi_token"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textNoSuggestions"
                    android:maxLines="3" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 4. Service-account key -->
            <TextView
                style="@style/PairSectionHeader"
                android:text="@string/pair_hdr_sa" />

            <TextView
                android:id="@+id/txt_sa_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodyMedium" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_import_sa"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/btn_import_sa" />

            <!-- 5. Options -->
            <TextView
                style="@style/PairSectionHeader"
                android:text="@string/pair_hdr_options" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/sw_inbound_enabled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sw_inbound_enabled" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/sw_otp_copy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/sw_otp_copy" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/sw_suppress_system"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/sw_suppress_system" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:alpha="0.7"
                android:lineSpacingExtra="2dp"
                android:text="@string/sw_suppress_system_hint"
                android:textAppearance="?attr/textAppearanceBodySmall" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/btn_save" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
