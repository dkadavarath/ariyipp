<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="12dp">

    <!-- Lays out the body and the meta row so they never overlap - see ChatBubbleLayout. -->
    <com.noti.logger.ui.widget.ChatBubbleLayout
        android:id="@+id/bubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/txt_body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textSize="15sp"
            android:letterSpacing="0"
            android:includeFontPadding="false"
            android:lineHeight="20sp" />

        <!-- Time + ticks: on the body's last line when it fits, otherwise on a row of its own.
             One TextView drawing the ticks as its end drawable (set in ChatActivity), not a row of
             three views - this is inflated for every bubble scrolled past. -->
        <TextView
            android:id="@+id/txt_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="3dp"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:paddingEnd="10dp"
            android:paddingBottom="8dp"
            android:textSize="11sp" />
    </com.noti.logger.ui.widget.ChatBubbleLayout>
</FrameLayout>
