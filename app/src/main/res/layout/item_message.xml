<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="12dp">

    <FrameLayout
        android:id="@+id/bubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/txt_body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textSize="14.5sp"
            android:includeFontPadding="false"
            android:lineHeight="16sp" />

        <!-- Overlaid on the reserved blank space at the end of txt_body's text (see
             reserveMetaSpace in ChatActivity), so it rides the last line instead of adding a row. -->
        <LinearLayout
            android:id="@+id/meta_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingEnd="10dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/txt_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:includeFontPadding="false" />

            <ImageView
                android:id="@+id/img_ticks"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_marginStart="3dp"
                android:src="@drawable/ic_double_check"
                android:visibility="gone"
                android:contentDescription="@null" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
