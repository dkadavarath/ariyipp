<?xml version="1.0" encoding="utf-8"?>
<!-- On back: the top screen slides out to the right and fades (shared-axis X, backward). -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@interpolator/emphasized">
    <translate android:fromXDelta="0" android:toXDelta="22%p" android:duration="300" />
    <alpha android:fromAlpha="1" android:toAlpha="0" android:duration="220" />
</set>
